{
  "name": "skillport",
  "version": "0.1.0",
  "description": "Manager for team AI Skills, Rules, and multi-platform distribution.",
  "main": "out/main/index.js",
  "bin": {
    "skillport": "bin/skillport.mjs"
  },
  "author": "SkillPort",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac --x64 --arm64 --publish never",
    "skillport": "node bin/skillport.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "fast-glob": "^3.3.3",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "semver": "^7.7.3",
    "yaml": "^2.8.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "build": {
    "appId": "com.skillport.desktop",
    "productName": "SkillPort",
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${platform}-${arch}.${ext}",
    "files": [
      "out/**"
    ],
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip",
        "tar.gz"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "msi",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
